<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <LinearLayout android:id="@+id/home" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="24dp"
        android:clipChildren="false" android:clipToPadding="false">
        <FrameLayout android:layout_width="match_parent" android:layout_height="64dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                android:layout_gravity="start" android:gravity="center_vertical">
                <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_mark"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AK TV"
                        android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="by Akshansh Sahu" android:textColor="#8E8E93" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:orientation="horizontal" android:padding="5dp"
                android:background="@drawable/seg_track">
                <TextView android:id="@+id/segLive" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Live TV" android:focusable="true" android:clickable="true" android:paddingStart="32dp"
                    android:paddingEnd="32dp" android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:textSize="15sp" android:fontFamily="sans-serif-medium" android:background="@drawable/chip_bg"/>
                <TextView android:id="@+id/segSites" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Movies &amp; Series" android:focusable="true" android:clickable="true" android:paddingStart="32dp"
                    android:paddingEnd="32dp" android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:textSize="15sp" android:fontFamily="sans-serif-medium" android:background="@drawable/chip_bg"/>
            </LinearLayout>
        </FrameLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/chips" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:clipToPadding="false"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="#8E8E93" android:textSize="13sp"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent"
            android:layout_height="match_parent" android:layout_marginTop="6dp" android:clipToPadding="false"
            android:clipChildren="false" android:paddingBottom="40dp"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/playerLayer" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#000000" android:visibility="gone">
        <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent"
            android:layout_height="match_parent" app:use_controller="false" app:resize_mode="fit"/>
        <TextView android:id="@+id/nowPlaying" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:layout_margin="32dp" android:paddingStart="24dp"
            android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:background="#B31C1C1E" android:textColor="#FFFFFF" android:textSize="18sp"
            android:fontFamily="sans-serif-medium"/>
        <ProgressBar android:id="@+id/spinner" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/splash" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#000000" android:orientation="vertical" android:gravity="center" android:clickable="true">
        <ImageView android:id="@+id/splashLogo" android:layout_width="140dp" android:layout_height="140dp" android:src="@drawable/ic_mark"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="AK TV" android:textColor="#FFFFFF" android:textSize="32sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="by Akshansh Sahu" android:textColor="#8E8E93" android:textSize="15sp"/>
    </LinearLayout>
</FrameLayout>
