<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="190dp" android:layout_margin="12dp"
    android:focusable="true" android:clickable="true">
    <LinearLayout android:id="@+id/siteBox" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="bottom" android:padding="24dp">
        <TextView android:id="@+id/siteName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="28sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/siteUrl" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#CCFFFFFF" android:textSize="13sp"/>
    </LinearLayout>
</FrameLayout>
